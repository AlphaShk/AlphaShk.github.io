---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Timeline from '../components/Timeline.astro';
import EduAwards from '../components/EduAwards.astro';
import Contact from '../components/Contact.astro';
import { getItems, profile } from '../lib/data';
import { lenses, smallerProjects } from '../site.config';

const lens = lenses.general;
const all = await getItems();
const pick = (slugs: string[]) => slugs.map((s) => all.find((i) => i.slug === s)).filter(Boolean) as typeof all;
const items = pick(lens.work);
const smaller = pick(smallerProjects);
const description = `${profile.headlines.general}. Target roles: AI / forward-deployed engineering, quant development and quant research. Based in ${profile.identity.location_line}.`;
---
<Base title="Denys Shkola: software engineer, AI systems and quant research" description={description} isHome compactFooter={false} jsonLd ogType="profile">
  <Hero lens="general" />

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <SectionHead kicker="§ 1" title="Selected work" id="work-title">
        <ul slot="aside" class="legend" aria-label="Status key">
          <li class="st st--public">public, opens</li>
          <li class="st st--private">private code</li>
          <li class="st st--competition">competition</li>
        </ul>
      </SectionHead>
      <WorkGrid items={items} features={['pulse', 'market-data-platform']} smaller={smaller} allCount={all.length} filter compact />
    </div>
  </section>

  <section class="section" id="experience" aria-labelledby="xp-title">
    <div class="wrap">
      <SectionHead kicker="§ 2" title="Experience" id="xp-title" />
      <Timeline figure={3} idPrefix="home" />
      <p class="sec-foot"><a class="arrow-link" href="/cv/">Full CV<span class="icon icon--arrow" aria-hidden="true"></span></a></p>
    </div>
  </section>

  <section class="section" id="education" aria-labelledby="edu-title">
    <div class="wrap">
      <SectionHead kicker="§ 3" title="Education & awards" id="edu-title" />
      <EduAwards awards={lens.homeAwards} />
    </div>
  </section>

  <Contact kicker="§ 4" />
</Base>
