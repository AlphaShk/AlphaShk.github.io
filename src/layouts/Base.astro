---
import '../styles/tokens.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/site.css';
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';
import { profile } from '../lib/data';

interface Props {
  title: string;
  description: string;
  isHome?: boolean;
  lens?: 'ai' | 'quant';
  section?: 'work' | 'research' | 'about' | 'cv';
  compactFooter?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: boolean;
  noindex?: boolean;
}
const { title, description, isHome = false, lens, section, compactFooter = true, ogType = 'website', jsonLd = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(site.ogImage, site.url).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.identity.name,
  url: site.url,
  jobTitle: 'Software Engineer',
  worksFor: { '@type': 'Organization', name: 'Erste Digital' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Vienna' },
  sameAs: [profile.identity.linkedin, profile.identity.github],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FAF8F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Denys Shkola: software engineer, AI systems and quant research" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      (function () {
        var d = document.documentElement, t = null;
        try { t = new URLSearchParams(location.search).get("theme") || localStorage.getItem("theme"); } catch (e) {}
        if (t === "light" || t === "dark") d.setAttribute("data-theme", t);
        d.classList.add("js");
        document.addEventListener("DOMContentLoaded", function () {
          var b = document.querySelector("[data-theme-toggle]");
          if (!b) return;
          var mq = window.matchMedia("(prefers-color-scheme: dark)");
          var cur = function () { return d.getAttribute("data-theme") || (mq.matches ? "dark" : "light"); };
          var sync = function () { b.setAttribute("aria-pressed", String(cur() === "dark")); };
          b.addEventListener("click", function () {
            var next = cur() === "dark" ? "light" : "dark";
            d.setAttribute("data-theme", next);
            try { localStorage.setItem("theme", next); } catch (e) {}
            sync();
          });
          if (mq.addEventListener) mq.addEventListener("change", sync);
          sync();
        });
      })();
    </script>
    <link rel="preload" as="font" type="font/woff2" href={newsreaderLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body class:list={[{ 'is-home': isHome }]}>
    <a class="skip" href="#main">Skip to content</a>
    <Header lens={lens} section={section} />
    <main id="main">
      <slot />
    </main>
    <Footer compact={compactFooter} />
  </body>
</html>
