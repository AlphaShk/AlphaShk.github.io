---
import Email from './Email.astro';
import { site } from '../site.config';

interface Props { lens?: 'ai' | 'quant'; section?: 'work' | 'research' | 'about' | 'cv' }
const { lens, section } = Astro.props;
const nav = [
  { key: 'work', href: '/work/', label: 'Work' },
  { key: 'research', href: '/research/', label: 'Research' },
  { key: 'about', href: '/about/', label: 'About' },
];
const lensSuffix = lens === 'ai' ? ' · AI' : lens === 'quant' ? ' · Quant' : '';
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label="Denys Shkola, home"><span class="wordmark__full">Denys Shkola{lensSuffix}</span><span class="wordmark__mono" aria-hidden="true">DS</span></a>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={section === n.key ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li class="site-nav__cv"><a href={site.cvPdf}>CV (PDF)</a></li>
      </ul>
    </nav>
    <div class="site-actions">
      <Email variant="header" />
      <a class="btn btn--sm header-cv" href={site.cvPdf}><span class="icon icon--doc" aria-hidden="true"></span>CV (PDF)</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Dark theme" title="Toggle dark theme">
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path></svg>
      </button>
    </div>
  </div>
</header>
