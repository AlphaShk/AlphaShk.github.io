---
import WorkCard from './WorkCard.astro';
import { trackLabel, type Item } from '../lib/data';
import { trackOrder, type TrackKey } from '../site.config';

interface Props {
  items: Item[];
  features?: string[];
  smaller?: Item[];
  allCount?: number;
  filter?: boolean;
  headingLevel?: 'h2' | 'h3';
  compact?: boolean;
}
const { items, features = [], smaller = [], allCount, filter = false, headingLevel = 'h3', compact = false } = Astro.props;
const featureItems = items.filter((i) => features.includes(i.slug)).slice(0, 2);
const rest = items.filter((i) => !featureItems.includes(i));
const allTracks = trackOrder.join(' ');
const smallerTracks = [...new Set(smaller.flatMap((i) => i.tracks))].join(' ');
const filterable = [...featureItems, ...rest, ...(smaller.length ? [{ tracks: smaller.flatMap((i) => i.tracks) }] : [])];
const total = featureItems.length + rest.length + (smaller.length ? 1 : 0);
const count = (t: TrackKey) => filterable.filter((i) => i.tracks.includes(t)).length;
let n = 0;
const next = () => ++n;
const short = (i: Item) => (i.data as { tagline?: string }).tagline || i.data.summary;
---
<div class="works">
  {filter && (
    <div class="filter__bar">
      <fieldset class="filter">
        <legend class="vh">Show work for a target role</legend>
        <input type="radio" name="track" id="f-all" value="all" checked />
        <label for="f-all">All <span class="n">{total}</span></label>
        {trackOrder.map((t) => (
          <Fragment>
            <input type="radio" name="track" id={`f-${t}`} value={t} />
            <label for={`f-${t}`}>{trackLabel(t)} <span class="n">{count(t)}</span></label>
          </Fragment>
        ))}
      </fieldset>
      <p class="filter__status" role="status">
        <span class="s-all">Showing {total} of {total}</span>
        {trackOrder.map((t) => <span class={`s-${t}`}>Showing {count(t)} of {total}: {trackLabel(t)}</span>)}
      </p>
      <script is:inline>(function(){try{var t=new URLSearchParams(location.search).get("track");if(t&&t.indexOf("quant")===0)t="quant";var e=t&&document.getElementById("f-"+t);if(e)e.checked=true;}catch(x){}})();</script>
    </div>
  )}
  <div class="work-grid">
    {featureItems.map((item, k) => <WorkCard item={item} index={next()} feature figNo={k + 1} headingLevel={headingLevel} />)}
    {rest.map((item) => <WorkCard item={item} index={next()} headingLevel={headingLevel} compact={compact} />)}
    {smaller.length > 0 && (
      <article class="card" id="smaller-projects" data-tracks={smallerTracks} aria-labelledby="smaller-title">
        <header class="card__head"><p class="card__meta"><span class="card__idx">{String(next()).padStart(2, '0')}</span>Public repos</p></header>
        <Fragment set:html={`<${headingLevel} class="card__title" id="smaller-title">Smaller projects</${headingLevel}>`} />
        <ul class="mini">
          {smaller.map((i) => (
            <li data-tracks={i.tracks.join(' ')}>
              <span><a class="mini__name" href={i.href}>{i.shortTitle}</a> <span class="mini__desc">{short(i)}</span></span>
              <span class="mini__links">
                {i.links.filter((l) => l.kind === 'demo' || l.kind === 'repo').map((l) => (
                  <a class="is-public" href={l.href}>{l.kind === 'demo' ? 'Live demo' : 'Repo'}<span class="icon icon--ext" aria-hidden="true"></span></a>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </article>
    )}
    {allCount && (
      <article class="card card--all" data-tracks={allTracks} aria-labelledby="all-title">
        <header class="card__head"><p class="card__meta">All work</p></header>
        <Fragment set:html={`<${headingLevel} class="card__title" id="all-title"><a href="/work/">All ${allCount} projects</a></${headingLevel}>`} />
        <p class="card__result">Every case study and project page, with a filter by target role.</p>
        <p class="card__links"><a class="arrow-link" href="/work/">Browse all work<span class="icon icon--arrow" aria-hidden="true"></span></a></p>
      </article>
    )}
  </div>
</div>
<script is:inline>(function(){
  // Filtering hides cards; layout() then resizes the visible ones so every row is full:
  // lg-* classes apply at >= 1024px (12 columns, rows of 3), md-* at 640-1023px (rows of 2).
  var SIZES=['lg-w4','lg-w6','lg-w8','lg-w12','md-w12'];
  function layout(cards){
    cards.forEach(function(c){ SIZES.forEach(function(k){ c.classList.remove(k); }); });
    var feats=cards.filter(function(c){ return c.classList.contains('card--feature'); });
    var rest=cards.filter(function(c){ return !c.classList.contains('card--feature'); });
    var lgRest=rest.slice();
    if(feats.length===1){
      if(lgRest.length){ feats[0].classList.add('lg-w8'); lgRest.shift().classList.add('lg-w4'); }
      else feats[0].classList.add('lg-w12');
    }
    var r=lgRest.length%3;
    if(r===1) lgRest[lgRest.length-1].classList.add('lg-w12');
    if(r===2){ lgRest[lgRest.length-1].classList.add('lg-w6'); lgRest[lgRest.length-2].classList.add('lg-w6'); }
    if(rest.length%2===1) rest[rest.length-1].classList.add('md-w12');
  }
  document.querySelectorAll('.works').forEach(function(w){
    var radios=w.querySelectorAll('.filter input[name="track"]');
    function apply(){
      var t=(w.querySelector('.filter input:checked')||{}).value||'all', n=0, vis=[];
      w.querySelectorAll('.work-grid > .card').forEach(function(c){
        var mini=c.querySelectorAll('.mini li[data-tracks]'), show;
        if(mini.length){ var k=0; mini.forEach(function(li){ var ok=t==='all'||(' '+li.dataset.tracks+' ').indexOf(' '+t+' ')>=0; li.hidden=!ok; if(ok)k++; }); show=k>0; }
        else if(c.classList.contains('card--all')) show=true;
        else show=t==='all'||(' '+(c.dataset.tracks||'')+' ').indexOf(' '+t+' ')>=0;
        c.hidden=!show;
        if(show) vis.push(c);
        var idx=c.querySelector('.card__idx'); if(show&&idx){ n++; idx.textContent=String(n).padStart(2,'0'); }
      });
      layout(vis);
    }
    radios.forEach(function(r){ r.addEventListener('change',apply); }); apply();
  });
})();</script>
